#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int T;
cin>>T;
while (T--){
    int N,K;
    string S;
    cin>>N>>K>>S;
    int alarms = 0;
        int i = 0;

        while (i < N) {
            if (S[i] == '1') {
                int alarmRoom = min(N - 1, i + K);
                ++alarms;
                i = alarmRoom + 1;
            } else {
                ++i;
            }
        }

        cout << alarms << '\n';
    }

    return 0;
}
